{
  "$defs": {
    "GeneratedQuestion": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "craftSlug": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Craftslug",
          "type": "string"
        },
        "question": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "expected": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "minItems": 1,
          "title": "Expected",
          "type": "array"
        },
        "field": {
          "anyOf": [
            {
              "enum": [
                "OVERVIEW",
                "PROCESS",
                "CHEMISTRY",
                "PHYSICS",
                "MATERIALS",
                "GEOGRAPHY",
                "GEOLOGY",
                "CLIMATE",
                "ECOLOGY",
                "BOTANY",
                "HISTORY",
                "ECONOMICS",
                "DESIGN",
                "HEALTH",
                "SOCIETY",
                "POLICY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "fields": {
          "default": [],
          "items": {
            "enum": [
              "OVERVIEW",
              "PROCESS",
              "CHEMISTRY",
              "PHYSICS",
              "MATERIALS",
              "GEOGRAPHY",
              "GEOLOGY",
              "CLIMATE",
              "ECOLOGY",
              "BOTANY",
              "HISTORY",
              "ECONOMICS",
              "DESIGN",
              "HEALTH",
              "SOCIETY",
              "POLICY"
            ],
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "fact": {
          "format": "uuid",
          "title": "Fact",
          "type": "string"
        },
        "language": {
          "pattern": "^[a-z]{2,3}$",
          "title": "Language",
          "type": "string"
        },
        "rejected": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Rejected",
          "type": "array"
        }
      },
      "required": [
        "key",
        "craftSlug",
        "question",
        "expected",
        "fact",
        "language"
      ],
      "title": "GeneratedQuestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "factsPerCraft": {
      "minimum": 1,
      "title": "Factspercraft",
      "type": "integer"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/GeneratedQuestion"
      },
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "version",
    "revision",
    "generatedAt",
    "seed",
    "factsPerCraft",
    "questions"
  ],
  "title": "GeneratedSet",
  "type": "object"
}
