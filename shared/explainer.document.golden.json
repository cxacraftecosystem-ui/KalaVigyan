          "processId": "3a3730fb-a5e7-563f-bb05-af878d8c4f2a",
          "stages": [
            {
              "stageId": "77bf953a-03a3-54c3-a1bb-37ac338266df",
              "ordinal": 4,
              "name": "Khariyanu (lime-gum resist outline printing)",
              "stageType": "RESIST",
              "level": "PROVISIONAL",
              "sentences": [
                {
                  "id": "s1.b1.1",
                  "text": "Outlines where white is required are printed with a carved block and a lime and tree-gum resist paste.",
                  "level": "PROVISIONAL",
                  "citations": [
                    {
                      "id": "1425b713-ec54-50d0-95af-13bd46973b16",
                      "claimId": "f363ce3a-c4a6-5b24-87e7-2634e18175cf",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Preparation of Outline of design (Khariyanu/ Kiriyana):- Outlines of the design, where white is required, are printed with a carved wooden block and a resist paste containing lime and tree gum.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 6",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ],
                  "translated": false,
                  "terms": [
                    {
                      "text": "resist paste",
                      "termKey": "resist-paste"
                    }
                  ]
                },
                {
                  "id": "s1.b1.2",
                  "text": "The dyer block-prints resist paste on areas that will remain white.",
                  "level": "PROVISIONAL",
                  "citations": [
                    {
                      "id": "d297bffd-4280-5880-b15e-0bcb1b216a35",
                      "claimId": "5e8d6976-2377-5e50-8410-623cd6561f99",
                      "sourceId": "f0dde764-b68a-5ea6-8d1c-05ca4a7db2b7",
                      "quote": "The dyer block-prints resist paste on the areas to remain white, and mordant pastes to fix the colour on the areas to be dyed red or black.",
                      "locator": "§ \"Object details\"",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    },
                    {
                      "id": "320fc86d-4cf8-577a-a7d8-e310d0f7dff7",
                      "claimId": "5e8d6976-2377-5e50-8410-623cd6561f99",
                      "sourceId": "84cc8e03-ef75-55a3-9fb6-ca8b8e872a93",
                      "quote": "The dyer block-prints resist paste on the areas to remain white, and mordant pastes to fix the colour on the areas to be dyed red or black.",
                      "locator": "§ \"Object details\"",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ],
                  "translated": false,
                  "terms": []
                }
              ],
              "materials": [],
              "conditions": [],
              "reactionIds": []
            },
            {
              "stageId": "5ced8309-b0f4-571a-8482-4223d1d4fccc",
              "ordinal": 5,
              "name": "Kut (iron-black printing)",
              "stageType": "PRINT",
              "level": "PROVISIONAL",
              "sentences": [
                {
                  "id": "s1.b1.3",
                  "text": "Areas where black is required are printed with kut paste, usually an infill (datla) between khariyanu outlines.",
                  "level": "PROVISIONAL",
                  "citations": [
                    {
                      "id": "d826d5c9-9361-556d-9a62-fb69781a67b8",
                      "claimId": "0bb14c01-aa8c-5c9e-940d-f0d1bac4a2e9",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Areas where black is required are now printed with kut paste. In true Ajrakh, this is usually an infill or datla between selected khariyanu outliners.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 6",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ],
                  "translated": false,
                  "terms": [
                    {
                      "text": "kut",
                      "termKey": "kut"
                    },
                    {
                      "text": "datla",
                      "termKey": "datla"
                    },
                    {
                      "text": "khariyanu",
                      "termKey": "khariyanu"
                    }
                  ]
                },
                {
                  "id": "s1.b1.4",
                  "text": "Printed on harde-treated cloth, kut develops a deep fast chocolate-black as iron reacts with the tannic acid.",
                  "level": "PROVISIONAL",
                  "citations": [
                    {
                      "id": "6211c7f6-8d84-5ac5-8528-256a5dc1cb5b",
                      "claimId": "8e106f5b-6c6e-5857-9d66-95ec73a07421",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "When printed onto the harde treated cloth kut develops a deep fast chocolate-black colour as the iron particles in the kut paste oxidise with the tannic acid.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 6",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ],
                  "translated": false,
                  "terms": [
                    {
                      "text": "harde",
                      "termKey": "harde"
                    }
                  ]
                }
              ],
              "materials": [
                {
                  "materialId": "6a3e5cb8-ef2e-501f-a7f8-d7d0772d56e4",
                  "name": "Kut (iron-water black paste)",
                  "kind": "MORDANT",
                  "role": "MORDANT",
                  "citations": [
                    {
                      "id": "bbda0126-cff0-5edb-b58b-1b9ee4f8bc1a",
                      "claimId": "c407fde1-3c40-5c81-8a5e-320317aacf9d",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Kut printing is usually undertaken in the afternoon.The kut is a smooth finer paste made from jaggery, or molasses, in which scrap iron such as horse-hoes and besan (gram flour) have been fermented for ten to fifteen days.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 6",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    },
                    {
                      "id": "cc110cce-fba5-54c5-aa96-14f4fae15347",
                      "claimId": "c407fde1-3c40-5c81-8a5e-320317aacf9d",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "The resulting liquid or “ironwater” is drained off and mixed with smooth tree gum paste.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 6",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ]
                }
              ],
              "conditions": [
                {
                  "label": "Fermenting the iron paste",
                  "stated": "ten to fifteen days",
                  "citations": [
                    {
                      "id": "bbda0126-cff0-5edb-b58b-1b9ee4f8bc1a",
                      "claimId": "c407fde1-3c40-5c81-8a5e-320317aacf9d",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Kut printing is usually undertaken in the afternoon.The kut is a smooth finer paste made from jaggery, or molasses, in which scrap iron such as horse-hoes and besan (gram flour) have been fermented for ten to fifteen days.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 6",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ]
                }
              ],
              "reactionIds": [
                "d9643f49-fefc-5e3a-ad08-a5ae499a4161"
              ]
            },
            {
              "stageId": "575d3427-7a90-568d-87d5-bb0f1c602591",
              "ordinal": 6,
              "name": "Pa (alum mordant printing for red)",
              "stageType": "MORDANT",
              "level": "PROVISIONAL",
              "sentences": [
                {
                  "id": "s1.b1.5",
                  "text": "Pa, a smooth paste of alum in tamarind-seed paste, is printed with blocks patterned for the mavi areas where red is required.",
                  "level": "PROVISIONAL",
                  "citations": [
                    {
                      "id": "44887a17-3ba2-551b-8ac3-8604beadc326",
                      "claimId": "9a3c214f-f54f-5f76-a5b7-88aa6a363489",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "This smooth paste called Pa, is printed with blocks which have been carved so that the printing portion of the raised face is patterned only, with the areas of the design called mavi, where red is required.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 6",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    },
                    {
                      "id": "bbc5ffe3-77cd-574c-81fe-dd953be4d0a7",
                      "claimId": "9a3c214f-f54f-5f76-a5b7-88aa6a363489",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Alum is suspended in a sticky paste of boiled powder from roasted and ground tamarind seeds (locally known as kachika).",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 6",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ],
                  "translated": false,
                  "terms": [
                    {
                      "text": "Pa",
                      "termKey": "pa"
                    },
                    {
                      "text": "mavi",
                      "termKey": "mavi"
                    }
                  ]
                }
              ],
              "materials": [
                {
                  "materialId": "e2c65ac5-52a9-5625-9ed7-ce0d1c1cb19c",
                  "name": "Alum (fatakdi)",
                  "kind": "MORDANT",
                  "role": "MORDANT",
                  "citations": [
                    {
                      "id": "c7c60b8b-8e49-5da9-9b60-3b3a7d360670",
                      "claimId": "1dcf0fe9-1f1c-518e-868b-5e54bcd44a2e",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Alum is used as a mordant in the process to fasten the colours.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 2",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ]
                }
              ],
              "conditions": [],
              "reactionIds": []
            },
            {
              "stageId": "eb895bd5-83a3-511a-9e64-ba7e452afea8",
              "ordinal": 11,
              "name": "Red dyeing (rang) with madder or alizarin",
              "stageType": "DYE",
              "level": "PROVISIONAL",
              "sentences": [
                {
                  "id": "s1.b1.6",
                  "text": "Alizarin crystals or steeped madder roots are heated in a copper pot; dyeing the purest reds continues for up to four hours.",
                  "level": "PROVISIONAL",
                  "citations": [
                    {
                      "id": "bcc71322-675e-51c1-b19c-84258612d340",
                      "claimId": "cd8140e6-98fc-5882-b261-766e143dd8c2",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Red Dyeing:- Alizarin crystals or the crushed and steeped roots of majeeta or Indian Madder are gently heated in a large copper pot.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 7",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    },
                    {
                      "id": "244a9196-0787-5a14-ad11-ed7d5ae200da",
                      "claimId": "cd8140e6-98fc-5882-b261-766e143dd8c2",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Dyeing the purest reds continues for up to four hours.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 8",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ],
                  "translated": false,
                  "terms": [
                    {
                      "text": "Alizarin",
                      "termKey": "alizarin"
                    },
                    {
                      "text": "madder",
                      "termKey": "madder"
                    }
                  ]
                }
              ],
              "materials": [
                {
                  "materialId": "a96fc53e-88ae-5f99-acd3-09346d9a67ea",
                  "name": "Indian madder (majith/majeeta, Rubia cordifolia)",
                  "kind": "DYE",
                  "role": "DYE",
                  "citations": [
                    {
                      "id": "59e42547-3723-53f0-b468-8af16d07504c",
                      "claimId": "542cae98-9a85-5410-a375-69334290d130",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "This dye extracted from these long thin roots links to the alum mordant on the cotton fibres and develops red area of a design, where Pa, Gach pastes have been printed.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 8",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    },
                    {
                      "id": "c3767047-5db1-5638-a64e-e3b9b61835ae",
                      "claimId": "542cae98-9a85-5410-a375-69334290d130",
                      "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                      "quote": "Ajrakh with Madder Dye:- Indian Madder roots, Rubia Cordifolia, locally known as majeeta, have been traditionally used in the creation of Ajrakh since Ajrakh itself was born many millennia ago.",
                      "locator": "GI Journal No. 188 copy (application 1050), PDF p. 8",
                      "context": null,
                      "evidence": "QUOTED",
                      "level": "PROVISIONAL"
                    }
                  ]
                }
              ],
              "conditions": [
                {
                  "label": "Red dye bath",
                  "stated": "up to four hours",
                  "citations": [
                    {
                      "id": "244a9196-0787-5a14-ad11-ed7d5ae200da",
                      "claimId": "cd8140e6-98fc-5882-b261-766e143dd8c2",
