  "sections": [
    {
      "id": "s1",
      "discipline": "PROCESS",
      "title": "How it is made",
      "order": 1,
      "state": "READY",
      "blocks": [
        {
          "id": "s1.b1",
          "kind": "process_ladder",
          "version": 1,
          "reuse": null,
          "craft": {
            "slug": "Kutch-Ajrakh",
            "name": "Kutch Ajrakh",
            "path": "/crafts/Kutch-Ajrakh"
