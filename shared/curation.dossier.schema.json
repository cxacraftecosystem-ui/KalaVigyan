{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KalaVigyan curated craft dossier",
  "$defs": {
    "After": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "colours": {
          "items": {
            "enum": [
              "RED",
              "BLUE",
              "BLACK",
              "WHITE",
              "GREEN",
              "YELLOW",
              "BROWN",
              "GREY",
              "PINK",
              "PURPLE",
              "ORANGE",
              "MAROON"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Colours",
          "type": "array"
        },
        "claimId": {
          "pattern": "^C\\d{3,4}$",
          "title": "Claimid",
          "type": "string"
        }
      },
      "required": [
        "text",
        "claimId"
      ],
      "title": "After",
      "type": "object"
    },
    "CitedQuote": {
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "pattern": "^S\\d{2,3}$",
          "title": "Sourceid",
          "type": "string"
        },
        "locator": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "quote": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "locator",
        "quote"
      ],
      "title": "CitedQuote",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^C\\d{3,4}$",
          "title": "Id",
          "type": "string"
        },
        "discipline": {
          "enum": [
            "OVERVIEW",
            "PROCESS",
            "CHEMISTRY",
            "PHYSICS",
            "MATERIALS",
            "GEOGRAPHY",
            "GEOLOGY",
            "CLIMATE",
            "ECOLOGY",
            "BOTANY",
            "HISTORY",
            "ECONOMICS",
            "DESIGN",
            "HEALTH",
            "SOCIETY",
            "POLICY"
          ],
          "title": "Discipline",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "quotes": {
          "items": {
            "$ref": "#/$defs/CitedQuote"
          },
          "minItems": 1,
          "title": "Quotes",
          "type": "array"
        },
        "hypothesis": {
          "default": false,
          "title": "Hypothesis",
          "type": "boolean"
        },
        "sensitivity": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "ATTRIBUTE_REQUIRED",
            "RESTRICTED"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "id",
        "discipline",
        "subject",
        "text",
        "quotes"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Community": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^G\\d{2,3}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "COMMUNITY",
            "PERSON",
            "ORGANISATION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "localNames": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Localnames",
          "type": "array"
        },
        "honours": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Honours",
          "type": "array"
        },
        "placeId": {
          "anyOf": [
            {
              "pattern": "^L\\d{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeid"
        },
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claimids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "claimIds"
      ],
      "title": "Community",
      "type": "object"
    },
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Claimids",
          "type": "array"
        },
        "about": {
          "maxLength": 300,
          "minLength": 1,
          "title": "About",
          "type": "string"
        }
      },
      "required": [
        "claimIds",
        "about"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "EnvironmentLink": {
      "additionalProperties": false,
      "properties": {
        "factor": {
          "enum": [
            "WATER",
            "SOIL",
            "CLIMATE",
            "LANDFORM",
            "VEGETATION",
            "OTHER"
          ],
          "title": "Factor",
          "type": "string"
        },
        "placeId": {
          "anyOf": [
            {
              "pattern": "^L\\d{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeid"
        },
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claimids",
          "type": "array"
        }
      },
      "required": [
        "factor",
        "claimIds"
      ],
      "title": "EnvironmentLink",
      "type": "object"
    },
    "Focal": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Focal",
      "type": "object"
    },
    "GiRecord": {
      "additionalProperties": false,
      "properties": {
        "applicationNumber": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicationnumber"
        },
        "certificateNumber": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certificatenumber"
        },
        "filedOn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filedon"
        },
        "registeredOn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registeredon"
        },
        "journalIssue": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journalissue"
        },
        "proprietors": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Proprietors",
          "type": "array"
        },
        "authorisedUserCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorisedusercount"
        },
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claimids",
          "type": "array"
        }
      },
      "required": [
        "claimIds"
      ],
      "title": "GiRecord",
      "type": "object"
    },
    "KeyFact": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claimids",
          "type": "array"
        }
      },
      "required": [
        "label",
        "value",
        "claimIds"
      ],
      "title": "KeyFact",
      "type": "object"
    },
    "Market": {
      "additionalProperties": false,
      "properties": {
        "gi": {
          "anyOf": [
            {
              "$ref": "#/$defs/GiRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prices": {
          "items": {
            "$ref": "#/$defs/Price"
          },
          "title": "Prices",
          "type": "array"
        },
        "workforce": {
          "items": {
            "$ref": "#/$defs/Workforce"
          },
          "title": "Workforce",
          "type": "array"
        },
        "imitation": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "title": "Imitation",
          "type": "array"
        }
      },
      "title": "Market",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^M\\d{2,3}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "FIBRE",
            "DYE",
            "MORDANT",
            "MINERAL",
            "CLAY",
            "METAL",
            "WOOD",
            "RESIN",
            "FUEL",
            "WATER",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "INPUT",
            "MORDANT",
            "DYE",
            "RESIST",
            "BINDER",
            "FLUX",
            "FUEL",
            "PRODUCT",
            "OTHER"
          ],
          "title": "Role",
          "type": "string"
        },
        "localNames": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Localnames",
          "type": "array"
        },
        "botanicalName": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Botanicalname"
        },
        "pubchemCid": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pubchemcid"
        },
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claimids",
          "type": "array"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/MaterialAlternative"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "role",
        "claimIds"
      ],
      "title": "Material",
      "type": "object"
    },
    "MaterialAlternative": {
      "additionalProperties": false,
      "properties": {
        "materialId": {
          "pattern": "^M\\d{2,3}$",
          "title": "Materialid",
          "type": "string"
        },
        "claimId": {
          "pattern": "^C\\d{3,4}$",
          "title": "Claimid",
          "type": "string"
        }
      },
      "required": [
        "materialId",
        "claimId"
      ],
      "title": "MaterialAlternative",
      "type": "object"
    },
    "MaterialUse": {
      "additionalProperties": false,
      "properties": {
        "materialId": {
          "pattern": "^M\\d{2,3}$",
          "title": "Materialid",
          "type": "string"
        },
        "claimId": {
          "pattern": "^C\\d{3,4}$",
          "title": "Claimid",
          "type": "string"
        }
      },
      "required": [
        "materialId",
        "claimId"
      ],
      "title": "MaterialUse",
      "type": "object"
    },
    "NativeName": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "language": {
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "title": "Language",
          "type": "string"
        },
        "script": {
          "anyOf": [
            {
              "pattern": "^[A-Z][a-z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "claimId": {
          "pattern": "^C\\d{3,4}$",
          "title": "Claimid",
          "type": "string"
        }
      },
      "required": [
        "text",
        "language",
        "claimId"
      ],
      "title": "NativeName",
      "type": "object"
    },
    "OpenQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^O\\d{2,3}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "title": "Claimids",
          "type": "array"
        },
        "settledBy": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settledby"
        },
        "subCategories": {
          "items": {
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
            "type": "string"
          },
          "title": "Subcategories",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "OpenQuestion",
      "type": "object"
    },
    "Overview": {
      "additionalProperties": false,
      "properties": {
        "lede": {
          "items": {
            "$ref": "#/$defs/OverviewSentence"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Lede",
          "type": "array"
        },
        "keyFacts": {
          "items": {
            "$ref": "#/$defs/KeyFact"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Keyfacts",
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/OverviewSection"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "lede",
        "keyFacts"
      ],
      "title": "Overview",
      "type": "object"
    },
    "OverviewSection": {
      "additionalProperties": false,
      "properties": {
        "discipline": {
          "enum": [
            "OVERVIEW",
            "PROCESS",
            "CHEMISTRY",
            "PHYSICS",
            "MATERIALS",
            "GEOGRAPHY",
            "GEOLOGY",
            "CLIMATE",
            "ECOLOGY",
            "BOTANY",
            "HISTORY",
            "ECONOMICS",
            "DESIGN",
            "HEALTH",
            "SOCIETY",
            "POLICY"
          ],
          "title": "Discipline",
          "type": "string"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/OverviewSentence"
          },
          "maxItems": 8,
          "minItems": 3,
          "title": "Sentences",
          "type": "array"
        }
      },
      "required": [
        "discipline",
        "sentences"
      ],
      "title": "OverviewSection",
      "type": "object"
    },
    "OverviewSentence": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claimids",
          "type": "array"
        },
        "subCategories": {
          "items": {
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
            "type": "string"
          },
          "title": "Subcategories",
          "type": "array"
        },
        "crafts": {
          "items": {
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
            "type": "string"
          },
          "title": "Crafts",
          "type": "array"
        }
      },
      "required": [
        "text",
        "claimIds"
      ],
      "title": "OverviewSentence",
      "type": "object"
    },
    "Picture": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^I\\d{2,3}$",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "pageUrl": {
          "title": "Pageurl",
          "type": "string"
        },
        "author": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "licence": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "licenceUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licenceurl"
        },
        "caption": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Caption",
          "type": "string"
        },
        "claimIds": {
          "items": {
            "pattern": "^C\\d{3,4}$",
            "type": "string"
          },
          "title": "Claimids",
          "type": "array"
        },
        "stageId": {
          "anyOf": [
            {
              "pattern": "^P\\d{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stageid"
        },
        "placement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Placement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "focal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Focal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "standIn": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standin"
        }
      },
      "required": [
        "id",
        "url",
        "pageUrl",
        "author",
        "licence",
        "caption"
      ],
      "title": "Picture",
      "type": "object"
    },
    "Place": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^L\\d{2,3}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "VILLAGE",
            "TOWN",
            "DISTRICT",
            "STATE",
            "COUNTRY",
            "REGION",
            "RIVER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "district": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District"
        },
        "state": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "country": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Country",
          "type": "string"
        },
        "wikidata": {
          "anyOf": [
            {
              "pattern": "^Q[1-9]\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
