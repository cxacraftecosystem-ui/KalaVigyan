                  "sourceId": "3cb53e85-da56-502e-8333-4fdbbb34b3ae",
                  "quote": "But the problem of water still persists because the level of water has been going down by 10-15 feet every year even here. We have to seriously think and plan for the future.\" Water is the lifeline of printing and dyeing.",
                  "locator": "§ \"We are running out of water\"",
                  "context": null,
                  "evidence": "QUOTED",
                  "level": "PROVISIONAL"
                }
