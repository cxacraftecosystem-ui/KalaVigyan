    {
      "id": "s2",
      "discipline": "CHEMISTRY",
      "blocks": [
        {
          "id": "s2.b1",
          "kind": "what_if",
          "version": 1,
          "reuse": null,
          "changed": "Red dye",
          "stageId": "eb895bd5-83a3-511a-9e64-ba7e452afea8",
          "options": [
            {
              "label": "Indian madder (majith/majeeta, Rubia cordifolia)",
              "materialId": "f688cdba-8a3c-5af9-847f-1a91998e0d52",
              "termKey": null,
              "outcomes": [
                {
                  "sentence": {
                    "id": "s2.b1.1",
                    "text": "The colour compounds in madder are more complex than those of synthetic alizarin, so dyeing with madder often leaves a pinkish tinge on the whites.",
                    "level": "PROVISIONAL",
                    "citations": [
                      {
                        "id": "e3479cd8-4210-5c5d-b9a9-7f3c26ca1d78",
                        "claimId": "d2ce3edb-6145-51a3-8d23-c044121c97c2",
                        "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                        "quote": "The color compounds contained within natural madder roots are much more complex than those of synthetic alizarin.",
                        "locator": "GI Journal No. 188 copy (application 1050), PDF p. 8",
                        "context": null,
                        "evidence": "QUOTED",
                        "level": "PROVISIONAL"
                      }
                    ],
                    "translated": false,
                    "terms": []
                  },
                  "reactionId": null
                },
                {
                  "sentence": {
                    "id": "s2.b1.2",
                    "text": "Tapano was developed to counteract the pinkish tinge that dyeing with madder leaves on the white areas.",
                    "level": "PROVISIONAL",
                    "citations": [
                      {
                        "id": "eaf85d81-68d6-5ce6-9c38-200e96349180",
                        "claimId": "f50cf605-3fb9-561f-b43e-ee01c198a7b1",
                        "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                        "quote": "dyeing with majeeta often leaves a pinkish tinge to the white areas of a design. Over time a procedure was developed to counteract this staining.",
                        "locator": "GI Journal No. 188 copy (application 1050), PDF p. 8",
                        "context": null,
                        "evidence": "QUOTED",
                        "level": "PROVISIONAL"
                      }
                    ],
                    "translated": false,
                    "terms": []
                  },
                  "reactionId": null
                }
              ]
            },
            {
              "label": "Synthetic alizarin",
              "materialId": "02a0d0b9-ae5d-571f-87ae-fe50175c8df2",
              "termKey": null,
              "outcomes": [
                {
                  "sentence": {
                    "id": "s2.b1.3",
                    "text": "Alizarin, first synthesised in 1868 by Graebe and Liebermann, superseded madder and also requires alum to attach colour.",
                    "level": "PROVISIONAL",
                    "citations": [
                      {
                        "id": "affc1bd0-6880-526d-9596-9dbb65a46218",
                        "claimId": "0899069c-80aa-5b60-bfb9-79eee94a39fe",
                        "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                        "quote": "Derived from coal tar this crystalline red dye rapidly superseded madder, its natural counterpart. Despite its chemical synthesis, alizarin dye also requires mordants such as alum to attach its colour to the cloth fibres.",
                        "locator": "GI Journal No. 188 copy (application 1050), PDF p. 8",
                        "context": null,
                        "evidence": "QUOTED",
                        "level": "PROVISIONAL"
                      },
                      {
                        "id": "5f985aeb-0585-573a-962e-a753c7e54d6f",
                        "claimId": "0899069c-80aa-5b60-bfb9-79eee94a39fe",
                        "sourceId": "d0f53ee9-4b97-5df7-a367-686957bdb7c8",
                        "quote": "(i) Ajrakh with Alizarin Dye:- Alizarin was one of the first chemical dyes for red, invented in 1868 by German chemists Graaebe and Liebermann.",
                        "locator": "GI Journal No. 188 copy (application 1050), PDF p. 8",
                        "context": null,
                        "evidence": "QUOTED",
                        "level": "PROVISIONAL"
                      }
                    ],
                    "translated": false,
                    "terms": []
                  },
                  "reactionId": null
                },
                {
                  "sentence": {
                    "id": "s2.b1.4",
                    "text": "Alizarin molecules can form six-member chelate rings with aluminium ions; it is also likely that the large complexes are physically trapped within the fibre.",
                    "level": "PROVISIONAL",
                    "citations": [
                      {
                        "id": "edad227e-f51e-5457-b8c0-bdedcb452326",
                        "claimId": "c4727f5f-13c0-5fb0-8f18-d579a8d92ace",
                        "sourceId": "9187df8b-62e3-510a-ba5d-827ec098c84c",
                        "quote": "The alizarin molecules are capable of forming six-member chelate rings with aluminum ions.",
                        "locator": "§ \"2 THE MORDANT-DYE COMPLEX\"",
                        "context": null,
                        "evidence": "QUOTED",
                        "level": "PROVISIONAL"
                      },
                      {
                        "id": "3c88bdb7-fc8a-5ee9-ac32-dd46df255d0e",
                        "claimId": "c4727f5f-13c0-5fb0-8f18-d579a8d92ace",
                        "sourceId": "9187df8b-62e3-510a-ba5d-827ec098c84c",
                        "quote": "It is also likely that the large complexes are physically trapped within the fiber.",
                        "locator": "§ \"2 THE MORDANT-DYE COMPLEX\"",
                        "context": null,
                        "evidence": "QUOTED",
                        "level": "PROVISIONAL"
                      }
                    ],
                    "translated": false,
                    "terms": []
                  },
                  "reactionId": "65916ac6-7a8e-57c9-baf6-6b0ba5f684da"
                }
              ]
            },
