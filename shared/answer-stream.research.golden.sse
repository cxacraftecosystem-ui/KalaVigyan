data: {"sectionId":"s1","block":{"id":"s1.b1","kind":"prose","version":1,"reuse":null,"sentences":[{"id":"s1.b1.1","text":"Alum is the mordant that binds alizarin to cotton.","level":"REVIEWED","citations":[{"id":"c0000000-0000-4000-8000-000000000001","claimId":"3f2a1b0c-9d8e-4f7a-8b6c-5d4e3f2a1b0c","sourceId":"1a2b3c4d-0000-4000-8000-000000000001","quote":"Alum is the mordant","locator":"p. 41","context":null,"evidence":"QUOTED","level":"REVIEWED"}],"terms":[{"text":"Alum","termKey":"alum"},{"text":"alizarin","termKey":"alizarin"},{"text":"cotton","termKey":"cotton"}]},{"id":"s1.b1.2","text":"Mordant baths held 8 g/L alum and were heated to 60 °C.","level":"PROVISIONAL","citations":[{"id":"c0000000-0000-4000-8000-000000000002","claimId":"6c1e0f2a-3b4d-4e5f-8a9b-0c1d2e3f4a5b","sourceId":"1a2b3c4d-0000-4000-8000-000000000002","quote":"Mordanting baths of 8 g/L alum were heated to 60 °C","locator":null,"context":null,"evidence":"QUOTED","level":"PROVISIONAL"}],"terms":[{"text":"alum","termKey":"alum"}]},{"id":"s1.b1.3","text":"The red lake withstood 20 washes.","level":"PROVISIONAL","citations":[{"id":"c0000000-0000-4000-8000-000000000003","claimId":"8d2f1a3b-4c5e-4f60-9b1c-2d3e4f5a6b7c","sourceId":"1a2b3c4d-0000-4000-8000-000000000003","quote":"the lake withstood 20 washes","locator":null,"context":null,"evidence":"QUOTED","level":"PROVISIONAL"}],"terms":[]}]}}

