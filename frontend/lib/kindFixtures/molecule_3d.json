  "facts": {
    "C071": {
      "text": "The finished article is dipped in a boiling solution of fort earth and ammonium chloride, which turns the zinc alloy black while the silver keeps its colour.",
      "quotes": [
        {
          "source": "S02",
          "locator": "lines 296-299",
          "quote": "The polished article is then dipped in a boiled solution of ammonium chloride and earth collected and available only from the fort area"
        },
        {
          "source": "S02",
          "locator": "lines 305-307",
          "quote": "By this process, the zinc portion ofthe articles become black and the silver portion retains its own colour."
        },
        {
          "source": "S03",
          "locator": "lines 1348-1349",
          "quote": "The finished article is now given a dip in this hot solution."
        },
        {
          "source": "S03",
          "locator": "lines 1350-1351",
          "quote": "The zinc alloy turns permanently jet black while the silver retains its brilliance."
        }
      ]
    }
  },
