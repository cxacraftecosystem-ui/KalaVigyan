{
  "agent": {
    "run_as_user": "cwagent",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "logs": {
    "force_flush_interval": 15,
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/kalavigyan/kv-api.log",
            "log_group_name": "/kalavigyan/kv-api",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/kalavigyan/kv-worker.log",
            "log_group_name": "/kalavigyan/kv-worker",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/kalavigyan/kv-fetcher.log",
            "log_group_name": "/kalavigyan/kv-fetcher",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/kalavigyan/kv-contributions.log",
            "log_group_name": "/kalavigyan/kv-contributions",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/nginx/kalavigyan-access.log",
            "log_group_name": "/kalavigyan/nginx-access",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/kalavigyan/nginx-error",
            "log_stream_name": "{instance_id}",
            "filters": [
              {
                "type": "exclude",
                "expression": "/(shared/answers|shared/lessons|upload-links|dataset-uploads|pages/previews|supplied-sources/slots)/"
              }
            ]
          }
        ]
      }
    }
  }
}
